{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ginny-comments",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "observability": { "enabled": true },
  "vars": {
    // 只允許這些來源跨域呼叫（草稿用 github.io，買網址後 ginny.me 已預先列入）
    "ALLOWED_ORIGINS": "https://weiqi-kids.github.io,https://ginny.me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ginny",
      "database_id": "65521f84-05fe-426c-84a6-a5570baaea47",
      "migrations_dir": "migrations"
    }
  ]
}
